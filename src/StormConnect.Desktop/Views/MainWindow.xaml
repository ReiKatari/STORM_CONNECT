<Window x:Class="StormConnect.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:StormConnect.Desktop.Controls"
        Title="STORM CONNECT 1.3.2"
        Width="1480" Height="860"
        MinWidth="1140" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        Background="{DynamicResource ThemeBgPrimary}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="{DynamicResource ThemeFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootScaleGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Procedural STORM Theme Aurora Background Layer -->
        <Canvas x:Name="AuroraBackdrop" IsHitTestVisible="False" Visibility="Collapsed">
            <Ellipse Width="720" Height="720" Opacity="0.22" Canvas.Left="-120" Canvas.Top="-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="640" Height="640" Opacity="0.18" Canvas.Right="-120" Canvas.Bottom="-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06B6D4" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Custom Chromeless TitleBar (Law 11 & 13) -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="/Assets/app_icon.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtWindowTitle" Text="STORM CONNECT 1.3.2" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Style="{StaticResource StormCaptionBtn}" Click="BtnMinimize_Click">
                            <Path Data="M 0 0 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource StormCaptionBtn}" Click="BtnMaximize_Click">
                            <Path x:Name="IconMaxRestore" Data="M 0 0 L 10 0 L 10 10 L 0 10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource StormCloseBtn}" Click="BtnClose_Click">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: Brand Header & 4 Dynamic Selectors (Responsive Multi-Row without clipping) -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeBgSecondary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Identity -->
                    <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Assets/app_icon.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="22" VerticalAlignment="Center"><Run Text="STORM" Foreground="{DynamicResource ThemeAccent}" FontWeight="Black"/><Run Text=" CONNECT" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold"/></TextBlock>
                            <TextBlock x:Name="TxtSubtitle" Text="High-Speed Multi-Monitor Remote Desktop, File Transfer &amp; Serverless Relay Suite"
                                       FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 Selectors + Updates + About -->
                    <WrapPanel x:Name="HeaderControlsPanel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ComboBox x:Name="CmbLang" Style="{StaticResource StormComboBox}" Width="122" Margin="0,0,8,4" SelectionChanged="CmbLang_SelectionChanged"/>
                        <ComboBox x:Name="CmbTheme" Style="{StaticResource StormComboBox}" Width="134" Margin="0,0,8,4" SelectionChanged="CmbTheme_SelectionChanged"/>
                        <ComboBox x:Name="CmbAccent" Style="{StaticResource StormComboBox}" Width="132" Margin="0,0,8,4" SelectionChanged="CmbAccent_SelectionChanged"/>
                        <ComboBox x:Name="CmbFont" Style="{StaticResource StormComboBox}" Width="136" Margin="0,0,8,4" SelectionChanged="CmbFont_SelectionChanged"/>
                        <Button x:Name="BtnUpdates" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnUpdates_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8 2 A 6 6 0 1 1 2.8 5 M 2 1.5 L 2 5.5 L 6 5.5" Stroke="#38BDF8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtBtnUpdates" Text="Updates" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAbout" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,0,4" Click="BtnAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8 1 A 7 7 0 1 0 8 15 A 7 7 0 1 0 8 1 M 8 7 L 8 11.5 M 8 4.5 L 8 4.8" Stroke="#FBBF24" StrokeThickness="1.7" StrokeStartLineCap="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtBtnAbout" Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ROW 2: Main Body -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Rail -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeBgSecondary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,1,0" Padding="12,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse x:Name="DotRelayStatus" Width="9" Height="9" Fill="{DynamicResource ThemeSuccess}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtRelayBadge" Text="Direct / Serverless Ready" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtActiveGuestsBadge" Text="Active Guests: 0" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource StormNavBtn}" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 2 8 L 8 2 L 14 8 M 4 7 L 4 14 L 12 14 L 12 7" Stroke="#8B5CF6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtNavDashboard" Text="Connect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavViewer" Style="{StaticResource StormNavBtn}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 1 2 L 15 2 L 15 11 L 1 11 Z M 5 14 L 11 14 M 8 11 L 8 14" Stroke="#06B6D4" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtNavViewer" Text="Remote Session" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavFiles" Style="{StaticResource StormNavBtn}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 1 3 L 6 3 L 8 5 L 15 5 L 15 13 L 1 13 Z" Stroke="#FBBF24" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtNavFiles" Text="File Manager" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAddressBook" Style="{StaticResource StormNavBtn}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 3 2 L 13 2 L 13 14 L 3 14 Z M 6 6 A 2 2 0 1 0 10 6 A 2 2 0 1 0 6 6 M 5 12 C 5 10 11 10 11 12" Stroke="#34D399" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtNavAddressBook" Text="Address Book" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavNetwork" Style="{StaticResource StormNavBtn}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8 2 A 6 6 0 1 0 8 14 A 6 6 0 1 0 8 2 M 2 8 L 14 8 M 8 2 C 10.5 4.5 10.5 11.5 8 14 M 8 2 C 5.5 4.5 5.5 11.5 8 14" Stroke="#EC4899" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtNavNetwork" Text="Network &amp; Relay" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource StormNavBtn}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8 5 A 3 3 0 1 0 8 11 A 3 3 0 1 0 8 5 M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.5 4.5 M 11.5 11.5 L 13 13 M 13 3 L 11.5 4.5 M 4.5 11.5 L 3 13" Stroke="#A78BFA" StrokeThickness="1.7" StrokeStartLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtNavSettings" Text="Settings &amp; Security" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content Panels -->
                <Grid Grid.Column="1" Margin="16">

                    <!-- 1. DASHBOARD / CONNECT -->
                    <ScrollViewer x:Name="PanelDashboard" VerticalScrollBarVisibility="Auto" Padding="0,0,16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1.25*"/>
                                </Grid.ColumnDefinitions>

                                <!-- My STORM ID & Serverless Invite Code Card -->
                                <Border Grid.Column="0" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLabelMyId" Text="YOUR STORM ID" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                        <WrapPanel Margin="0,8,0,10" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtMyStormId" Text="000 000 000" FontSize="28" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                                            <Button x:Name="BtnCopyId" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnCopyId_Click">
                                                <TextBlock x:Name="TxtBtnCopyId" Text="Copy ID"/>
                                            </Button>
                                            <Button x:Name="BtnCopyInvite" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,0,4" Click="BtnCopyInvite_Click">
                                                <TextBlock x:Name="TxtBtnCopyInvite" Text="Copy Invite Code"/>
                                            </Button>
                                        </WrapPanel>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="TxtLabelPin" Text="ONE-TIME PIN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                <TextBlock x:Name="TxtMyPin" Text="000000" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="BtnRefreshPin" Style="{StaticResource StormSecondaryBtn}" VerticalAlignment="Center" Click="BtnRefreshPin_Click">
                                                <TextBlock x:Name="TxtBtnRefreshPin" Text="Refresh PIN"/>
                                            </Button>
                                        </Grid>

                                        <CheckBox x:Name="ChkAllowIncoming" Content="Incoming Access" IsChecked="True" Checked="ChkAllowIncoming_Changed" Unchecked="ChkAllowIncoming_Changed"/>
                                        <CheckBox x:Name="ChkEnableUnattendedDash" Content="Enable password login" IsChecked="True" Margin="0,8,0,0" Checked="ChkEnableUnattended_Changed" Unchecked="ChkEnableUnattended_Changed"/>
                                        <TextBlock x:Name="TxtUnattendedStatusDash" Text="Password not set" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="27,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Connect Card -->
                                <Border Grid.Column="2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLabelQuickConnect" Text="CONNECT TO REMOTE DEVICE" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                        <Grid Margin="0,10,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtTargetInput" Style="{StaticResource StormInput}" TextChanged="TxtStormId_AutoFormat" KeyDown="TxtTargetInput_KeyDown"/>
                                            <Button Grid.Column="2" x:Name="BtnConnect" Style="{StaticResource StormPrimaryBtn}" MinWidth="142" Click="BtnConnect_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 7 1 L 2 9 L 7 9 L 5 15 L 14 6 L 8 6 Z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="TxtBtnConnect" Text="Connect" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Connection Method Selector -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtLabelConnMethod" Text="Connection Method:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="CmbConnMethod" Style="{StaticResource StormComboBox}" Width="280" SelectionChanged="CmbConnMethod_SelectionChanged"/>
                                        </StackPanel>

                                        <TextBlock x:Name="TxtConnectStatus" Text="Ready." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" TextWrapping="Wrap"/>

                                        <!-- Live Telemetry Strip -->
                                        <WrapPanel Margin="0,12,0,0">
                                            <Border Background="{DynamicResource ThemeBgSecondary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,6">
                                                <TextBlock x:Name="BadgeFps" Text="FPS: 0" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="{DynamicResource ThemeBgSecondary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,6">
                                                <TextBlock x:Name="BadgeRtt" Text="RTT: 0 ms" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="{DynamicResource ThemeBgSecondary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,6">
                                                <TextBlock x:Name="BadgeMbps" Text="0.00 Mbps" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="{DynamicResource ThemeBgSecondary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,6">
                                                <TextBlock x:Name="BadgeSavings" Text="Delta: 0%" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- LAN Discovered Devices -->
                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLabelLanDevices" Text="DISCOVERED ON LOCAL NETWORK (LAN)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtNoLanDevices" Text="Scanning local network for STORM CONNECT devices..." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5"/>
                                    <WrapPanel x:Name="LanDevicesPanel" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Live Telemetry Chart -->
                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLabelTelemetry" Text="LIVE PERFORMANCE TELEMETRY" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                                    <ctrl:LiveChartControl x:Name="TelemetryChart" Height="175"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. REMOTE SESSION VIEWER -->
                    <Grid x:Name="PanelViewer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Quick 1-click multi-monitor pills + All Monitors panoramic drag mode + Move active window -->
                                <WrapPanel x:Name="MonitorBarContainer" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <WrapPanel x:Name="MonitorPillsPanel" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnMoveWindowMonitor" Style="{StaticResource StormSecondaryBtn}" Margin="6,0,0,4" Click="BtnMoveWindowMonitor_Click">
                                        <TextBlock x:Name="TxtBtnMoveWindow" Text="Move Window -> Monitor"/>
                                    </Button>
                                </WrapPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbMonitorSelect" Style="{StaticResource StormComboBox}" Width="210" Margin="0,0,8,4" SelectionChanged="CmbMonitorSelect_SelectionChanged"/>
                                    <ComboBox x:Name="CmbQuality" Style="{StaticResource StormComboBox}" Width="140" Margin="0,0,8,4" SelectionChanged="CmbQuality_SelectionChanged"/>
                                    <Button x:Name="BtnAudioToggle" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnAudioToggle_Click">
                                        <TextBlock x:Name="TxtBtnAudio" Text="Audio: ON"/>
                                    </Button>
                                    <Button x:Name="BtnTaskMgr" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnTaskMgr_Click">
                                        <TextBlock x:Name="TxtBtnTaskMgr" Text="TaskMgr"/>
                                    </Button>
                                    <Button x:Name="BtnLockRemote" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnLockRemote_Click">
                                        <TextBlock x:Name="TxtBtnLockRemote" Text="Lock PC"/>
                                    </Button>
                                    <Button x:Name="BtnWinRun" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnWinRun_Click">
                                        <TextBlock Text="Win+R"/>
                                    </Button>
                                    <Button x:Name="BtnAltTab" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnAltTab_Click">
                                        <TextBlock Text="Alt+Tab"/>
                                    </Button>
                                    <Button x:Name="BtnScreenshot" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnScreenshot_Click">
                                        <TextBlock x:Name="TxtBtnScreenshot" Text="Screenshot"/>
                                    </Button>
                                    <Button x:Name="BtnToggleChat" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnToggleChat_Click">
                                        <TextBlock x:Name="TxtBtnChat" Text="Session Chat"/>
                                    </Button>
                                    <Button x:Name="BtnFullscreen" Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,4" Click="BtnFullscreen_Click">
                                        <TextBlock x:Name="TxtBtnFullscreen" Text="Fullscreen"/>
                                    </Button>
                                    <Button x:Name="BtnDisconnect" Style="{StaticResource StormPrimaryBtn}" Margin="0,0,8,4" Click="BtnDisconnect_Click">
                                        <TextBlock x:Name="TxtBtnDisconnect" Text="Disconnect" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Border Background="{DynamicResource ThemeBgSecondary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtViewerHud" Text="Idle" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="RemoteViewportHost" Grid.Column="0" Background="#07060F" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="10" Focusable="True" ClipToBounds="True"
                                    MouseMove="RemoteScreen_MouseMove" MouseDown="RemoteScreen_MouseDown" MouseUp="RemoteScreen_MouseUp"
                                    MouseWheel="RemoteScreen_MouseWheel" KeyDown="RemoteScreen_KeyDown" KeyUp="RemoteScreen_KeyUp"
                                    TextInput="RemoteScreen_TextInput">
                                <Grid>
                                    <Image x:Name="ImgRemoteScreen" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel x:Name="ViewerEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtNoActiveSession" Text="No active remote session." FontSize="15" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtDropFilesHint" Text="Drag &amp; Drop files here" FontSize="12.5" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="PanelChatDrawer" Grid.Column="1" Width="280" Visibility="Collapsed" Margin="10,0,0,0"
                                    Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" x:Name="TxtChatTitle" Text="SESSION CHAT" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtChatInput" Style="{StaticResource StormInput}" KeyDown="TxtChatInput_KeyDown"/>
                                        <Button Grid.Column="2" Style="{StaticResource StormPrimaryBtn}" Padding="12,8" Click="BtnSendChat_Click">
                                            <TextBlock Text=">" Foreground="#FFFFFF"/>
                                        </Button>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                        <StackPanel x:Name="ChatMessagesPanel"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 3. DUAL-PANE FILE MANAGER -->
                    <Grid x:Name="PanelFiles" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="TxtLabelLocalFiles" Text="LOCAL COMPUTER" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtLocalPath" Style="{StaticResource StormInput}" KeyDown="TxtLocalPath_KeyDown"/>
                                    <Button Grid.Column="2" Style="{StaticResource StormSecondaryBtn}" Click="BtnLocalUp_Click"><TextBlock x:Name="TxtLocalUp" Text="Up"/></Button>
                                    <Button Grid.Column="4" Style="{StaticResource StormPrimaryBtn}" Click="BtnUploadSelected_Click"><TextBlock x:Name="TxtUploadBtn" Text="Upload ->" Foreground="#FFFFFF"/></Button>
                                </Grid>
                                <DataGrid x:Name="GridLocalFiles" Style="{StaticResource StormDataGrid}" MouseDoubleClick="GridLocalFiles_DoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ColLocalName" Header="NAME" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn x:Name="ColLocalSize" Header="SIZE" Binding="{Binding SizeDisplay}" Width="95"/>
                                        <DataGridTextColumn x:Name="ColLocalMod" Header="MODIFIED" Binding="{Binding ModifiedDisplay}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="TxtLabelRemoteFiles" Text="REMOTE COMPUTER" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtRemotePath" Style="{StaticResource StormInput}" KeyDown="TxtRemotePath_KeyDown"/>
                                    <Button Grid.Column="2" Style="{StaticResource StormSecondaryBtn}" Click="BtnRemoteUp_Click"><TextBlock x:Name="TxtRemoteUp" Text="Up"/></Button>
                                    <Button Grid.Column="4" Style="{StaticResource StormSecondaryBtn}" Click="BtnRemoteRefresh_Click"><TextBlock x:Name="TxtRemoteRefresh" Text="Refresh"/></Button>
                                    <Button Grid.Column="6" Style="{StaticResource StormPrimaryBtn}" Click="BtnDownloadSelected_Click"><TextBlock x:Name="TxtDownloadBtn" Text="&lt;- Download" Foreground="#FFFFFF"/></Button>
                                </Grid>
                                <DataGrid x:Name="GridRemoteFiles" Style="{StaticResource StormDataGrid}" MouseDoubleClick="GridRemoteFiles_DoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ColRemoteName" Header="NAME" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn x:Name="ColRemoteSize" Header="SIZE" Binding="{Binding SizeDisplay}" Width="95"/>
                                        <DataGridTextColumn x:Name="ColRemoteMod" Header="MODIFIED" Binding="{Binding ModifiedDisplay}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtFileTransferStatus" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <ProgressBar Grid.Column="2" x:Name="PbFileTransfer" Height="12" Minimum="0" Maximum="100" Value="0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 4. ADDRESS BOOK -->
                    <Border x:Name="PanelAddressBook" Visibility="Collapsed" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtBookSearch" Style="{StaticResource StormInput}" TextChanged="TxtBookSearch_TextChanged"/>
                                <Button Grid.Column="2" Style="{StaticResource StormPrimaryBtn}" Click="BtnAddDevice_Click">
                                    <TextBlock x:Name="TxtBtnAddDevice" Text="Add Device" Foreground="#FFFFFF"/>
                                </Button>
                            </Grid>

                            <DataGrid x:Name="GridAddressBook" Style="{StaticResource StormDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColBookAlias" Header="DEVICE NAME" Binding="{Binding Alias}" Width="1.2*"/>
                                    <DataGridTextColumn x:Name="ColBookStormId" Header="STORM ID" Binding="{Binding FormattedId}" Width="140"/>
                                    <DataGridTextColumn x:Name="ColBookHost" Header="HOST / IP" Binding="{Binding HostOrIp}" Width="150"/>
                                    <DataGridTextColumn x:Name="ColBookGroup" Header="GROUP" Binding="{Binding Group}" Width="120"/>
                                    <DataGridTextColumn x:Name="ColBookMac" Header="MAC (WOL)" Binding="{Binding MacAddress}" Width="140"/>
                                    <DataGridTextColumn x:Name="ColBookAuth" Header="ACCESS" Binding="{Binding AuthDisplay}" Width="135"/>
                                    <DataGridTemplateColumn x:Name="ColBookActions" Header="ACTIONS" Width="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource StormPrimaryBtn}" Padding="10,4" Margin="0,0,6,0" Click="BtnBookConnect_Click" Tag="{Binding}">
                                                        <TextBlock Text="{Binding ConnectLabel}" FontSize="11.5" Foreground="#FFFFFF"/>
                                                    </Button>
                                                    <Button Style="{StaticResource StormSecondaryBtn}" Padding="8,4" Margin="0,0,6,0" Click="BtnBookWol_Click" Tag="{Binding}">
                                                        <TextBlock Text="{Binding WolLabel}" FontSize="11.5"/>
                                                    </Button>
                                                    <Button Style="{StaticResource StormSecondaryBtn}" Padding="8,4" Click="BtnBookDelete_Click" Tag="{Binding}">
                                                        <TextBlock Text="X" FontSize="11.5" Foreground="{DynamicResource ThemeError}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 5. NETWORK, SERVERLESS DIRECT ACCESS & RELAY -->
                    <ScrollViewer x:Name="PanelNetwork" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,16,14">
                        <StackPanel>
                            <!-- Serverless Direct Access Info Card -->
                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLabelServerlessTitle" Text="DIRECT SERVERLESS ACCESS (NO SERVER REQUIRED)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtDirectAddresses" Text="LAN / VPN / IPv6 / UPnP / STUN..." FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnRefreshNetMap" Style="{StaticResource StormPrimaryBtn}" Margin="0,0,10,6" Click="BtnRefreshNetMap_Click">
                                            <TextBlock x:Name="TxtBtnRefreshNetMap" Text="Refresh NAT / UPnP" Foreground="#FFFFFF"/>
                                        </Button>
                                        <Button Style="{StaticResource StormSecondaryBtn}" Margin="0,0,0,6" Click="BtnCopyInvite_Click">
                                            <TextBlock x:Name="TxtBtnNetCopyInvite" Text="Copy Invite Code"/>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLabelRelayUrl" Text="STORM CONNECT Relay URL (WSS)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtRelayUrl" Style="{StaticResource StormInput}" Margin="0,0,0,12"/>

                                    <TextBlock x:Name="TxtLabelDirectPort" Text="Direct LAN / TCP Port" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtDirectPort" Style="{StaticResource StormInput}" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                    <CheckBox x:Name="ChkEnableRelay" Content="Enable Cloud Relay Fallback" IsChecked="True" Margin="0,0,0,14"/>
                                    <Button x:Name="BtnSaveNetwork" Style="{StaticResource StormPrimaryBtn}" HorizontalAlignment="Left" Click="BtnSaveNetwork_Click">
                                        <TextBlock x:Name="TxtBtnSaveNetwork" Text="Save Network Settings" Foreground="#FFFFFF"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLabelEmbeddedRelay" Text="Run Embedded Team Relay Hub on this PC" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtDeployNote" Text="Use deploy/ for private relay." Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnToggleEmbeddedRelay" Style="{StaticResource StormPrimaryBtn}" Click="BtnToggleEmbeddedRelay_Click">
                                            <TextBlock x:Name="TxtBtnEmbeddedRelay" Text="Start Local Hub" Foreground="#FFFFFF"/>
                                        </Button>
                                        <TextBlock x:Name="TxtEmbeddedRelayStats" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 6. SETTINGS & SECURITY -->
                    <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,16,14">
                        <StackPanel>
                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkEnableUnattendedSettings" Content="Enable password login" IsChecked="True" Margin="0,0,0,8" Checked="ChkEnableUnattended_Changed" Unchecked="ChkEnableUnattended_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtLabelUnattended" Text="Unattended Access Password" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtUnattendedStatusSettings" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <WrapPanel Margin="0,0,0,14">
                                        <PasswordBox x:Name="PwdUnattended" Style="{StaticResource StormPassword}" Width="280" Margin="0,0,8,6"/>
                                        <Button Style="{StaticResource StormPrimaryBtn}" Margin="0,0,8,6" Click="BtnSaveUnattended_Click">
                                            <TextBlock x:Name="TxtBtnSavePwd" Text="Save Password" Foreground="#FFFFFF"/>
                                        </Button>
                                        <Button Style="{StaticResource StormSecondaryBtn}" Margin="0,0,0,6" Click="BtnClearUnattended_Click">
                                            <TextBlock x:Name="TxtBtnClearPwd" Text="Clear"/>
                                        </Button>
                                    </WrapPanel>

                                    <CheckBox x:Name="ChkPermControl" Content="Allow Mouse &amp; Keyboard Control" IsChecked="True" Margin="0,0,0,8" Checked="Perm_Changed" Unchecked="Perm_Changed"/>
                                    <CheckBox x:Name="ChkPermClipboard" Content="Allow Two-Way Clipboard Sync" IsChecked="True" Margin="0,0,0,8" Checked="Perm_Changed" Unchecked="Perm_Changed"/>
                                    <CheckBox x:Name="ChkPermFiles" Content="Allow File Transfer" IsChecked="True" Margin="0,0,0,8" Checked="Perm_Changed" Unchecked="Perm_Changed"/>
                                    <CheckBox x:Name="ChkPermAudio" Content="Allow Audio Streaming" IsChecked="True" Margin="0,0,0,8" Checked="Perm_Changed" Unchecked="Perm_Changed"/>
                                    <CheckBox x:Name="ChkPermSystem" Content="Allow System Actions" IsChecked="True" Margin="0,0,0,14" Checked="Perm_Changed" Unchecked="Perm_Changed"/>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtLabelUiScale" Text="Interface Scale" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Slider x:Name="SliderUiScale" Width="220" Minimum="0.80" Maximum="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1.0" ValueChanged="SliderUiScale_ValueChanged"/>
                                        <TextBlock x:Name="TxtScaleVal" Text="100%" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLabelAuditLog" Text="SESSION AUDIT LOG" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="GridAuditLog" Style="{StaticResource StormDataGrid}" Height="240">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="ColAuditTime" Header="DATE &amp; TIME" Binding="{Binding TimestampDisplay}" Width="160"/>
                                            <DataGridTextColumn x:Name="ColAuditPeer" Header="PEER" Binding="{Binding Peer}" Width="170"/>
                                            <DataGridTextColumn x:Name="ColAuditMode" Header="MODE" Binding="{Binding Mode}" Width="135"/>
                                            <DataGridTextColumn x:Name="ColAuditAction" Header="EVENT" Binding="{Binding Action}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- MODAL OVERLAYS (All dismissible via ESC) -->
        <Grid x:Name="ModalConsent" Visibility="Collapsed" Background="#B0000000">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ThemeHeaderBg}"
                    BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="TxtConsentTitle" Text="INCOMING CONNECTION REQUEST" FontSize="16" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtConsentDetails" Text="" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <CheckBox x:Name="ChkConsentControl" Content="Allow Mouse &amp; Keyboard Control" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkConsentClipboard" Content="Allow Clipboard Sync" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkConsentFiles" Content="Allow File Transfer" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkConsentAudio" Content="Allow Audio" IsChecked="True" Margin="0,0,0,16"/>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,0" Click="BtnConsentDecline_Click"><TextBlock x:Name="TxtConsentDecline" Text="Decline"/></Button>
                        <Button Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,0" Click="BtnConsentViewOnly_Click"><TextBlock x:Name="TxtConsentViewOnly" Text="View Only"/></Button>
                        <Button Style="{StaticResource StormPrimaryBtn}" Click="BtnConsentAccept_Click"><TextBlock x:Name="TxtConsentAccept" Text="Accept Full Control" Foreground="#FFFFFF"/></Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ModalAuth" Visibility="Collapsed" Background="#B0000000">
            <Border Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ThemeHeaderBg}"
                    BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="TxtAuthTitle" Text="REMOTE AUTHENTICATION" FontSize="15" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtAuthMsg" Text="Enter PIN or Unattended Password:" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtAuthError" Text="" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeError}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
                    <PasswordBox x:Name="PwdRemoteAuth" Style="{StaticResource StormPassword}" Margin="0,0,0,12" KeyDown="PwdRemoteAuth_KeyDown"/>
                    <CheckBox x:Name="ChkRememberConnection" Content="Save connection &amp; password" IsChecked="False" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtRememberAlias" Style="{StaticResource StormInput}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,0" Click="BtnAuthCancel_Click"><TextBlock x:Name="TxtAuthCancel" Text="Cancel"/></Button>
                        <Button x:Name="BtnAuthOk" Style="{StaticResource StormPrimaryBtn}" Click="BtnAuthOk_Click"><TextBlock x:Name="TxtAuthOk" Text="OK" Foreground="#FFFFFF"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ModalAddDevice" Visibility="Collapsed" Background="#B0000000">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ThemeHeaderBg}"
                    BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="TxtAddDevTitle" Text="Add Device" FontSize="16" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,12"/>
                    <TextBox x:Name="TxtAddAlias" Style="{StaticResource StormInput}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtAddStormId" Style="{StaticResource StormInput}" TextChanged="TxtStormId_AutoFormat" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtAddHost" Style="{StaticResource StormInput}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtAddMac" Style="{StaticResource StormInput}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtAddGroup" Style="{StaticResource StormInput}" Text="" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtAddDevPwdLabel" Text="Permanent password (optional)" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdAddDevicePassword" Style="{StaticResource StormPassword}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,0" Click="BtnAddDevCancel_Click"><TextBlock x:Name="TxtAddDevCancel" Text="Cancel"/></Button>
                        <Button Style="{StaticResource StormPrimaryBtn}" Click="BtnAddDevSave_Click"><TextBlock x:Name="TxtAddDevSave" Text="OK" Foreground="#FFFFFF"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ModalUpdate" Visibility="Collapsed" Background="#B0000000">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ThemeHeaderBg}"
                    BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="TxtUpdateTitle" Text="UPDATE AVAILABLE" FontSize="16" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtUpdateSummary" Text="" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtUpdateNotes" Text="" FontSize="12.5" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <ProgressBar x:Name="PbUpdateDownload" Height="10" Visibility="Collapsed" Minimum="0" Maximum="100" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource StormSecondaryBtn}" Margin="0,0,8,0" Click="BtnUpdateLater_Click"><TextBlock x:Name="TxtUpdateLater" Text="Later"/></Button>
                        <Button x:Name="BtnUpdateInstall" Style="{StaticResource StormPrimaryBtn}" Click="BtnUpdateInstall_Click"><TextBlock x:Name="TxtUpdateInstall" Text="Update" Foreground="#FFFFFF"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ModalAbout" Visibility="Collapsed" Background="#B0000000">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ThemeHeaderBg}"
                    BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="14" Padding="26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Image Source="/Assets/app_icon.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="22"><Run Text="STORM" Foreground="{DynamicResource ThemeAccent}" FontWeight="Black"/><Run Text=" CONNECT" FontWeight="Bold"/></TextBlock>
                            <TextBlock x:Name="TxtAboutVersion" Text="1.3.2" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TxtAboutDesc" Text="" FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <Button Style="{StaticResource StormPrimaryBtn}" HorizontalAlignment="Right" Click="BtnAboutClose_Click">
                        <TextBlock x:Name="TxtAboutClose" Text="Close" Foreground="#FFFFFF"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
