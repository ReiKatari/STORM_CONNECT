<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dynamic Theme Defaults (overwritten live by ThemeService) -->
    <SolidColorBrush x:Key="ThemeBgPrimary" Color="#0D0B18"/>
    <SolidColorBrush x:Key="ThemeBgSecondary" Color="#141026"/>
    <SolidColorBrush x:Key="ThemeHeaderBg" Color="#16112B"/>
    <SolidColorBrush x:Key="ThemeCardBg" Color="#1B1536"/>
    <SolidColorBrush x:Key="ThemeCardBorder" Color="#352B63"/>
    <SolidColorBrush x:Key="ThemeInputBg" Color="#100D1E"/>
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#B8B2D8"/>
    <SolidColorBrush x:Key="ThemeSuccess" Color="#34D399"/>
    <SolidColorBrush x:Key="ThemeWarning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="ThemeError" Color="#FB7185"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="ThemeAccentSecondary" Color="#06B6D4"/>
    <SolidColorBrush x:Key="ThemeAccentSoft" Color="#2E8B5CF6"/>
    <SolidColorBrush x:Key="ThemeAccentHover" Color="#508B5CF6"/>
    <SolidColorBrush x:Key="ThemeScrollThumb" Color="#60FFFFFF"/>
    <LinearGradientBrush x:Key="ThemeAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="ThemeFontFamily">Inter, Segoe UI, Arial</FontFamily>

    <!-- Global Base Typography -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 3D Volumetric Primary Action Button -->
    <Style x:Key="StormPrimaryBtn" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="ShadowBorder" CornerRadius="9" Margin="0,3,0,-2" Background="#70000000"/>
                        <Border x:Name="MainBorder" CornerRadius="9" Background="{DynamicResource ThemeAccentGradient}"
                                BorderThickness="1,1.2,1,2.5" BorderBrush="#55FFFFFF" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="14" Opacity="0.45" Color="#8B5CF6"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Opacity" Value="0.93"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.965" ScaleY="0.965"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3D Volumetric Secondary Button -->
    <Style x:Key="StormSecondaryBtn" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="BtnBorder" CornerRadius="8" Background="{DynamicResource ThemeCardBg}"
                            BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1,1,1,2.2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.015" ScaleY="1.015"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.965" ScaleY="0.965"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation Sidebar Tab Button -->
    <Style x:Key="StormNavBtn" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="NavBg" CornerRadius="9" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="ActiveBar" Width="3.5" HorizontalAlignment="Left" Margin="-12,2,0,2"
                                    CornerRadius="2" Background="{DynamicResource ThemeAccent}" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            <Setter TargetName="NavBg" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Recessed 3D TextBox with Strict Vertical Center Alignment (Law 18) -->
    <Style x:Key="StormInput" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="InputBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StormPassword" TargetType="{x:Type PasswordBox}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="PwdBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PwdBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            <Setter TargetName="PwdBorder" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 100% Theme-Styled ComboBox & Popup (Law 19) -->
    <Style x:Key="StormComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0,26,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource ThemeCardBg}"
                                            BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
                                        <Grid>
                                            <Path Data="M 0 0 L 4.5 4.5 L 9 0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="340"
                                    Margin="0,4,0,0" CornerRadius="8" Background="{DynamicResource ThemeHeaderBg}"
                                    BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                                <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                <Border x:Name="ItemBd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Themed ScrollBar (Law 12) -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="MinWidth" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border x:Name="ThumbBd" CornerRadius="4" Margin="1"
                                                Background="{DynamicResource ThemeScrollThumb}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="9"/>
                <Setter Property="MinHeight" Value="9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBd" CornerRadius="4" Margin="1"
                                                        Background="{DynamicResource ThemeScrollThumb}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 100% Contrast DataGrid with Vertical Separators (Law 10 & 12) -->
    <Style x:Key="StormDataGrid" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeCardBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ThemeCardBorder}"/>
        <Setter Property="RowBackground" Value="{DynamicResource ThemeCardBg}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeBgSecondary}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="FontFamily" Value="{DynamicResource ThemeFontFamily}"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titlebar Vector Window Control Buttons (Law 11) -->
    <Style x:Key="StormCaptionBtn" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="2,4"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.91" ScaleY="0.91"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StormCloseBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource StormCaptionBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.91" ScaleY="0.91"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
