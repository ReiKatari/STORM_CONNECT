<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>WFO1000</NoWarn>
    <ApplicationIcon>..\..\AppIcon.ico</ApplicationIcon>
    <AssemblyName>STORM_CONNECT_1.3.0_Setup</AssemblyName>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyTitle>STORM CONNECT</AssemblyTitle>
    <Product>STORM CONNECT</Product>
    <Title>STORM CONNECT</Title>
    <Description>STORM CONNECT</Description>
    <Company>STORM TEAM</Company>
    <Authors>STORM TEAM</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\Payload.zip" Link="Payload\Payload.zip" Condition="Exists('Payload\Payload.zip')" />
    <EmbeddedResource Include="..\..\AppIcon.ico" Link="Resources\AppIcon.ico" />
    <EmbeddedResource Include="..\..\Assets\app_icon.png" Link="Resources\app_icon.png" />
    <EmbeddedResource Include="Payload\STORM_SERTIFICATE.cer" Link="Resources\STORM_SERTIFICATE.cer" Condition="Exists('Payload\STORM_SERTIFICATE.cer')" />
  </ItemGroup>

</Project>
